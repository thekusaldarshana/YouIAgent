{
  "name": "youiagent",
  "version": "0.1.0",
  "description": "A local, source-grounded LangGraph pipeline for product launch films.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node setup.mjs",
    "setup:check": "node setup.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "start": "node dist/web/server.js",
    "dev": "npm run build && npm start",
    "film": "node dist/harness/graph/run.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.294",
    "@langchain/core": "1.2.13",
    "@langchain/langgraph": "1.4.18",
    "gsap": "3.14.2",
    "hyperframes": "0.8.80",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
