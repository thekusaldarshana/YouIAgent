{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "newLine": "lf",
    "noEmitOnError": true
  },
  "include": ["harness/**/*.ts", "web/**/*.ts", "shared/**/*.ts", "setup/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "web/client/**", "harness/motion/mechanics.ts", "harness/node_modules"]
}
