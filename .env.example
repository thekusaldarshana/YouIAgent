# Optional semantic source-claim gate. Without it, exact source quotes are checked locally.
OPENROUTER_API_KEY=

# Optional. Adds a Context.dev styleguide to source capture when set.
CONTEXT_DEV_API_KEY=

# Optional. Move local jobs and uploads (default: .youiagent inside this folder).
# YOUIAGENT_HOME=/absolute/path/to/state

# Optional binary overrides. The project already supports ffmpeg and ffprobe on PATH.
# FFMPEG_BIN=/absolute/path/to/ffmpeg
# FFPROBE_BIN=/absolute/path/to/ffprobe
