# Keep the reproducible OSS harness and local web app; exclude jobs and secrets.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/SECURITY.md
!/CONTRIBUTING.md
!/harness/
!/web/

# Keep the selected harness source while excluding trials, job histories, and dependencies.
/harness/*
!/harness/package.json
!/harness/package-lock.json
!/harness/cli.mjs
!/harness/runtime.test.mjs
!/harness/motion/
!/harness/eval/
!/harness/graph/
!/harness/worker/
!/harness/skills/
/harness/eval/*
!/harness/eval/claim-jev.mjs
/harness/skills/*
!/harness/skills/film-graph/
/harness/bench/

# Web source adapters and the local film studio.
/web/*
!/web/config.mjs
!/web/context-style.mjs
!/web/context-style.test.mjs
!/web/private-keys.mjs
!/web/source.mjs
!/web/server.mjs
!/web/job-state.mjs
!/web/job-state.test.mjs
!/web/smoke.test.mjs
!/web/package.json
!/web/README.md
!/web/public/
!/web/.gitignore

# Generated output, local state, credentials, and local tooling.
**/node_modules/
/.youiagent/
/.local/
/web/.local/
/extra/
/brag-output/
/pilot/
/studio/
.env
.env.*
!.env.example
*.mp4
*.m4v
*.mov
*.webm
*.mkv
*.avi
*.mp3
*.m4a
*.wav
*.ogg
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.log
coverage/
npm-debug.log*
