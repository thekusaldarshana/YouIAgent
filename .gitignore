# Keep the reproducible OSS harness and local web app; exclude jobs and secrets.
/*
!/.gitignore
!/README.md
!/RELEASE_CHECKLIST.md
!/docs/
/docs/*
!/docs/engineering/
/docs/engineering/*
!/docs/engineering/TS_MIGRATION_PLAN.md
!/docs/engineering/TS_MIGRATION_CODEX_PROMPT.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.base.json
!/tsconfig.client.json
!/tsconfig.scripts.json
!/setup.mjs
!/setup/
!/scripts/
!/shared/
!/test/
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/check.yml
!/LICENSE
!/NOTICE
!/SECURITY.md
!/CONTRIBUTING.md
!/harness/
!/web/

# Keep the selected harness source while excluding trials, job histories, and dependencies.
/harness/*
!/harness/cli.ts
!/harness/runtime.test.ts
!/harness/runtime/
!/harness/motion/
!/harness/media/
!/harness/eval/
!/harness/graph/
!/harness/worker/
!/harness/skills/
/harness/eval/*
!/harness/eval/claim-jev.ts
/harness/skills/*
!/harness/skills/film-graph/
!/harness/skills/film-brand/
!/harness/skills/film-concept/
!/harness/skills/film-motion/
!/harness/skills/film-review/
/harness/bench/

# Web source adapters and the local film studio.
/web/*
!/web/*.ts
!/web/client/
!/web/README.md
!/web/public/
!/web/.gitignore

# Generated output, local state, credentials, and local tooling.
**/node_modules/
/dist/
/.youiagent/
/.local/
/web/.local/
/extra/
/brag-output/
/pilot/
/studio/
.env
.env.*
!.env.example
*.mp4
*.m4v
*.mov
*.webm
*.mkv
*.avi
*.mp3
!/harness/media/music/*.mp3
*.m4a
*.wav
*.ogg
*.jpg
*.jpeg
*.png
!web/public/*.png
*.gif
*.webp
*.log
coverage/
npm-debug.log*
